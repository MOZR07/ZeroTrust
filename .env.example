# Server Ports
PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002

# Zero Trust Secrets
GATEWAY_SECRET=super-secure-internal-gateway-secret-2026
JWT_SECRET=jwt-access-secret-zerotrust-2026
JWT_SERVICE_SECRET=jwt-service-secret-zerotrust-2026

# Access Hours Policy (07:00 - 21:00)
ACCESS_HOURS_START=7
ACCESS_HOURS_END=21
# Set to 'false' if wanting to test outside-hours or simulate specific hour
MOCK_HOUR=

# Database
DB_PATH=./database/zerotrust.db

# Service Auth Credentials
SERVICE_NILAI_CLIENT_ID=service-nilai
SERVICE_NILAI_CLIENT_SECRET=secret-nilai-12345
